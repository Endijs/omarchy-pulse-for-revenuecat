#!/usr/bin/env bash

set -euo pipefail

state_dir=${FAKE_SECRET_STATE:?}
mkdir -p "$state_dir"

command=${1:-}
shift || true

label=""
service=""
project=""
while (( $# > 0 )); do
  case $1 in
    --label=*) label=${1#--label=} ;;
    --all|--unlock) ;;
    service) service=${2:-}; shift ;;
    project) project=${2:-}; shift ;;
  esac
  shift
done

safe_service=${service//[^A-Za-z0-9_.-]/_}
safe_project=${project//[^A-Za-z0-9_.-]/_}
secret_file=$state_dir/$safe_service--$safe_project

case $command in
  store)
    secret=$(</dev/stdin)
    printf '%s' "$secret" >"$secret_file"
    printf '%s' "$label" >"$secret_file.label"
    ;;
  lookup)
    [[ -f $secret_file ]] || exit 1
    printf '%s\n' "$(<"$secret_file")"
    ;;
  clear)
    [[ ${FAKE_CLEAR_FAIL:-0} != 1 ]] || exit 2
    if [[ -n $project ]]; then
      [[ -f $secret_file ]] || exit 1
      rm -f -- "$secret_file" "$secret_file.label"
    else
      shopt -s nullglob
      matches=("$state_dir/$safe_service"--*)
      (( ${#matches[@]} > 0 )) || exit 1
      rm -f -- "${matches[@]}"
    fi
    ;;
  search)
    [[ ${FAKE_SEARCH_FAIL:-0} != 1 ]] || exit 2
    shopt -s nullglob
    if [[ -n $project ]]; then
      matches=("$secret_file")
    else
      matches=("$state_dir/$safe_service"--*)
    fi
    for match in "${matches[@]}"; do
      [[ -f $match && $match != *.label ]] || continue
      printf 'attribute.service = %s\n' "$service"
    done
    ;;
  *)
    printf 'Unsupported fake secret-tool command: %s\n' "$command" >&2
    exit 2
    ;;
esac
